    <ui:VisualElement style="flex-grow: 1; background-color: rgb(55, 55, 55); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-left-color: rgb(84, 84, 84); border-right-color: rgb(84, 84, 84); border-top-color: rgb(84, 84, 84); border-bottom-color: rgb(84, 84, 84); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;">
        <ui:Label tabindex="-1" text="Label" display-tooltip-when-elided="true" name="CoBiName" style="text-overflow: ellipsis;" />
